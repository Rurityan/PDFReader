<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDFReader.ViewModels"
        xmlns:model="using:PDFReader.Models"
        xmlns:controls="using:PDFReader.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PDFReader.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        Title="PDF Reader">
    <Window.Styles>
        <Style Selector="Button.settings-button">
            <Setter Property="Background" Value="#EEF1F4" />
            <Setter Property="Foreground" Value="#303943" />
        </Style>
        <Style Selector="Button.settings-button:pointerover">
            <Setter Property="Background" Value="#E6A23C" />
            <Setter Property="Foreground" Value="#20252B" />
        </Style>
        <Style Selector="Button.settings-button:pressed">
            <Setter Property="Background" Value="#D18B22" />
            <Setter Property="Foreground" Value="#20252B" />
        </Style>
        <Style Selector="Button.settings-button:focus">
            <Setter Property="Background" Value="#E6A23C" />
            <Setter Property="Foreground" Value="#20252B" />
        </Style>
        <Style Selector="Button.topbar-button">
            <Setter Property="Background" Value="#20252B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.topbar-button:pointerover">
            <Setter Property="Background" Value="#3A424B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.annotation-tool">
            <Setter Property="Background" Value="#F1F3F5" />
            <Setter Property="Foreground" Value="#3B454F" />
        </Style>
        <Style Selector="ToggleButton.mode-button">
            <Setter Property="Background" Value="#F1F3F5" />
            <Setter Property="Foreground" Value="#4A5560" />
        </Style>
        <Style Selector="ToggleButton.mode-button:checked">
            <Setter Property="Background" Value="#E6A23C" />
            <Setter Property="Foreground" Value="#20252B" />
        </Style>
        <Style Selector="TextBlock.bookmark-title:pointerover">
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,Auto,*" Background="#F5F6F8">
        <Border Grid.Row="0" Background="#20252B" Padding="20,14">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="PDF READER" Foreground="#FFFFFF" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Width="1" Height="22" Background="#50565E" />
                    <TextBlock Text="{Binding DocumentTitle}" Foreground="#C7CDD4" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Foreground="#AAB2BB" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Button Grid.Column="3"
                        x:Name="FileMenuButton"
                        Content="文件"
                        Click="OpenFileMenuClick"
                        Padding="12,6"
                        Classes="topbar-button">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding}">
                            <MenuItem Header="保存 PDF"
                                      IsEnabled="{Binding HasDocument}"
                                      Click="SavePdfClick" />
                            <MenuItem Header="另存为"
                                      IsEnabled="{Binding HasDocument}"
                                      Click="SavePdfAsClick" />
                            <MenuItem Header="全量导出 PDF"
                                      IsEnabled="{Binding HasDocument}"
                                      Click="ExportPortablePdfClick" />
                            <MenuItem Header="导出 Adobe Acrobat 富媒体 PDF"
                                      IsEnabled="{Binding HasDocument}"
                                      Click="ExportAcrobatRichMediaPdfClick" />
                            <MenuItem Header="导出 HTML5 阅读包"
                                      IsEnabled="{Binding HasDocument}"
                                      Click="ExportHtml5Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Grid.Column="4"
                        Content="资源"
                        Click="OpenResourceManagerClick"
                        Padding="12,6"
                        Classes="topbar-button"
                        IsEnabled="{Binding HasDocument}" />
                <Button Grid.Column="5"
                        Content="设置"
                        Click="OpenSettingsClick"
                        Padding="12,6"
                        Classes="settings-button" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D9DDE2" BorderThickness="0,0,0,1" Padding="18,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Stretch">
                <Grid MinWidth="1420"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto"
                      VerticalAlignment="Center"
                      Margin="0,0,0,14">
                <Button Grid.Column="0"
                        x:Name="SidebarToggleButton"
                        Content="◀"
                        Click="ToggleSidebarClick"
                        Width="38"
                        Height="36"
                        FontSize="18"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Padding="0"
                        ToolTip.Tip="折叠左侧栏" />
                <Button Grid.Column="1" Click="OpenFileClick" Padding="14,7" Background="#2B6CB0" Foreground="White" Content="打开 PDF" />
                <Border Grid.Column="2" Width="1" Height="24" Background="#D9DDE2" Margin="16,0" />
                <Button Grid.Column="3" Command="{Binding GoPreviousCommand}" Padding="10,7" Content="上一页" />
                <Button Grid.Column="4" Command="{Binding GoNextCommand}" Padding="10,7" Margin="6,0,0,0" Content="下一页" />
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="14,0">
                    <TextBox Text="{Binding PageNumberInput, Mode=TwoWay}"
                             Width="54"
                             Height="30"
                             TextAlignment="Center"
                             IsEnabled="{Binding HasDocument}"
                             ToolTip.Tip="输入页码" />
                    <TextBlock Text="/" FontSize="13" Foreground="#4A5560" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DocumentPageCount}" FontSize="13" Foreground="#4A5560" VerticalAlignment="Center" />
                    <Button Content="跳转"
                            Command="{Binding JumpToPageCommand}"
                            IsEnabled="{Binding HasDocument}"
                            Padding="8,5"
                            ToolTip.Tip="跳转到指定页" />
                </StackPanel>
                <Button Grid.Column="6"
                        Content="{Binding CurrentPageOcrButtonText}"
                        Command="{Binding ToggleCurrentPageOcrCommand}"
                        IsEnabled="{Binding HasDocument}"
                        Margin="12,0,0,0"
                        Padding="10,7" />
                <Button Grid.Column="7"
                        Content="↶"
                        Command="{Binding UndoBookmarkDeleteCommand}"
                        IsEnabled="{Binding CanUndoBookmarkDelete}"
                        FontSize="24"
                        Width="42"
                        Height="36"
                        Margin="6,0,0,0"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="撤回删除" />
                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6">
                    <Button Command="{Binding ZoomOutCommand}" Padding="9,7" Content="-" />
                    <TextBox x:Name="ZoomInput"
                             Text="{Binding ZoomIndicator, Mode=TwoWay}"
                             Width="58"
                             Height="30"
                             Padding="4,2"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             IsEnabled="{Binding HasDocument}"
                             KeyDown="ZoomInputKeyDown"
                             LostFocus="ZoomInputLostFocus"
                             ToolTip.Tip="输入 50% 到 300% 的缩放比例" />
                    <Button Command="{Binding ZoomInCommand}" Padding="9,7" Content="+" />
                </StackPanel>
                <StackPanel Grid.Column="9"
                            Orientation="Horizontal"
                            Spacing="4"
                            IsVisible="{Binding IsAnnotationMode}"
                            Margin="12,0,0,0">
                    <Button x:Name="SelectAnnotationToolButton"
                            Classes="annotation-tool"
                            Tag="Select"
                            Click="AnnotationToolClick"
                            Width="36"
                            Height="34"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="选择 PDF 标注">
                        <PathIcon Width="16"
                                  Height="19"
                                  Data="M 1,1 L 1,17 L 5.8,12.2 L 9.3,19 L 11.3,18 L 7.9,11.2 L 15,11.2 Z" />
                    </Button>
                    <Button x:Name="TextAnnotationToolButton"
                            Classes="annotation-tool"
                            Content="文本"
                            Tag="Text"
                            Click="AnnotationToolClick"
                            Padding="8,7"
                            ToolTip.Tip="文本标注" />
                    <Button x:Name="LineAnnotationToolButton"
                            Classes="annotation-tool"
                            Content="线"
                            Tag="Line"
                            Click="AnnotationToolClick"
                            Padding="8,7"
                            ToolTip.Tip="画线" />
                    <Button x:Name="FreehandAnnotationToolButton"
                            Classes="annotation-tool"
                            Content="自由"
                            Tag="Freehand"
                            Click="AnnotationToolClick"
                            Padding="8,7"
                            ToolTip.Tip="自由绘制" />
                    <Button x:Name="RectangleAnnotationToolButton"
                            Classes="annotation-tool"
                            Content="方框"
                            Tag="Rectangle"
                            Click="AnnotationToolClick"
                            Padding="8,7"
                            ToolTip.Tip="方框标注" />
                    <Button x:Name="HighlightAnnotationToolButton"
                            Classes="annotation-tool"
                            Content="高亮"
                            Tag="Highlight"
                            Click="AnnotationToolClick"
                            Padding="8,7"
                            ToolTip.Tip="高亮显示" />
                    <Button x:Name="EraserAnnotationToolButton"
                            Classes="annotation-tool"
                            Content="擦除"
                            Tag="Eraser"
                            Click="AnnotationToolClick"
                            Padding="8,7"
                            ToolTip.Tip="橡皮擦" />
                    <Button Content="↶"
                            Command="{Binding UndoAnnotationDeleteCommand}"
                            IsEnabled="{Binding CanUndoAnnotationDelete}"
                            Padding="8,7"
                            ToolTip.Tip="撤回删除标注" />
                </StackPanel>
                <Button Grid.Column="11"
                        Margin="18,0,0,0"
                        Padding="12,7"
                        Content="{Binding AnnotationButtonText}"
                        Command="{Binding ToggleAnnotationCommand}"
                        IsEnabled="{Binding CanModifyDocument}" />
                <Button Grid.Column="12"
                        Margin="6,0,0,0"
                        Padding="12,7"
                        Content="保存标注"
                        Command="{Binding SaveAnnotationsCommand}"
                        IsEnabled="{Binding CanSaveAnnotations}"
                        ToolTip.Tip="将缓存中的标注写入 PDF 文件" />
                <Button Grid.Column="13"
                        Margin="6,0,0,0"
                        Padding="12,7"
                        Content="{Binding ReadCurrentPageButtonText}"
                        Command="{Binding ToggleReadCurrentPageCommand}"
                        IsEnabled="{Binding CanReadCurrentPage}" />
                <Button Grid.Column="14"
                        Margin="6,0,0,0"
                        Padding="12,7"
                        Content="{Binding ReadPageOnlyButtonText}"
                        Command="{Binding ReadPageOnlyCommand}"
                        IsEnabled="{Binding CanReadPageOnly}" />
                <Button Grid.Column="15"
                        Margin="6,0,0,0"
                        Padding="12,7"
                        Content="{Binding AudioPauseButtonText}"
                        Command="{Binding TogglePauseAudioCommand}"
                        IsVisible="{Binding IsAudioControlsVisible}"
                        IsEnabled="{Binding IsAudioControlsVisible}" />
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid x:Name="ContentLayout" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="230" MinWidth="180" MaxWidth="420" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#EEF1F4" BorderBrush="#D9DDE2" BorderThickness="0,0,1,0" Padding="4,12">
                <StackPanel Spacing="8">
                    <ToggleButton Classes="mode-button"
                                  Content="▦"
                                  Command="{Binding ShowPagePreviewPaneCommand}"
                                  IsChecked="{Binding IsPagePreviewPaneVisible, Mode=TwoWay}"
                                  IsVisible="{Binding EnablePagePreviews}"
                                  IsEnabled="{Binding HasDocument}"
                                  Width="30"
                                  Height="34"
                                  FontSize="18"
                                  Padding="0"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  ToolTip.Tip="页面缩略图" />
                    <ToggleButton Classes="mode-button"
                                  Content="☷"
                                  Command="{Binding ShowBookmarkPaneCommand}"
                                  IsChecked="{Binding IsBookmarkPaneVisible, Mode=OneWay}"
                                  Width="30"
                                  Height="34"
                                  FontSize="18"
                                  Padding="0"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  ToolTip.Tip="书签树" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D9DDE2" BorderThickness="0,0,1,0" Padding="12,14">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <TextBlock Grid.Row="0" Text="PDF 工作区" FontSize="13" FontWeight="SemiBold" Foreground="#66717C" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Documents}"
                             SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                             Height="105"
                             SelectionChanged="DocumentSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="model:PdfDocument">
                                <Grid Margin="0,3" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding FilePath}"
                                               TextWrapping="Wrap"
                                               Foreground="#37414A"
                                               FontSize="11" />
                                    <Border Grid.Column="1"
                                            Background="#D99A21"
                                            CornerRadius="3"
                                            Padding="5,2"
                                            VerticalAlignment="Top"
                                            IsVisible="{Binding IsArchived}">
                                        <TextBlock Text="已归档"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2">
                        <Border Background="#F5F7F9"
                                BorderBrush="#E1E5E9"
                                BorderThickness="1"
                                Padding="8"
                                IsVisible="{Binding IsPagePreviewPaneVisible}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                            <TextBlock Text="页面预览" FontSize="12" FontWeight="SemiBold" Foreground="#66717C" />
                            <ListBox x:Name="PagePreviewList"
                                     Grid.Row="1"
                                     ItemsSource="{Binding PagePreviews}"
                                     SelectedItem="{Binding SelectedPagePreview, Mode=TwoWay}"
                                     SelectionChanged="PagePreviewSelectionChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="model:PagePreview">
                                        <StackPanel Width="160" Spacing="4" Margin="3,5" HorizontalAlignment="Center">
                                            <Border Background="White" BorderBrush="#C8D0D8" BorderThickness="1" Padding="3">
                                                <Image Source="{Binding Image}"
                                                       Width="150"
                                                       Height="210"
                                                       Stretch="Uniform"
                                                       AttachedToVisualTree="PagePreviewImageAttachedToVisualTree"
                                                       DetachedFromVisualTree="PagePreviewImageDetachedFromVisualTree" />
                                            </Border>
                                            <TextBlock Text="{Binding PageNumber}"
                                                       FontSize="10"
                                                       Foreground="#5D6873"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Grid>
                        </Border>
                        <Grid IsVisible="{Binding IsBookmarkPaneVisible}" RowDefinitions="Auto,*" RowSpacing="12">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBlock Text="书签" FontSize="13" FontWeight="SemiBold" Foreground="#66717C" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="+"
                                        Click="CreateBookmarkClick"
                                        IsEnabled="{Binding CanModifyDocument}"
                                        Width="36"
                                        Height="36"
                                        FontSize="25"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip.Tip="创建书签" />
                                <Button Grid.Column="2"
                                        Content="⌖"
                                        Click="FindCurrentPageBookmarkClick"
                                        Width="36"
                                        Height="36"
                                        FontSize="23"
                                        Padding="0"
                                        Margin="5,0,0,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip.Tip="查找当前页书签" />
                                <Button Grid.Column="3"
                                        Content="🔎"
                                        Click="FindBookmarkByNameClick"
                                        Width="36"
                                        Height="36"
                                        FontSize="17"
                                        Padding="0"
                                        Margin="5,0,0,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip.Tip="按名称查找书签位置" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <TreeView x:Name="BookmarkTree"
                                          ItemsSource="{Binding Bookmarks}"
                                          SelectedItem="{Binding SelectedBookmark, Mode=TwoWay}"
                                          DoubleTapped="BookmarkDoubleTapped">
                                    <TreeView.DataTemplates>
                                <TreeDataTemplate DataType="model:Bookmark"
                                                  x:DataType="model:Bookmark"
                                                  ItemsSource="{Binding DisplayChildren}">
                                    <Grid Classes="bookmark-row" ColumnDefinitions="Auto,*" Margin="0,3" Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu DataContext="{Binding}" Opened="BookmarkContextMenuOpened">
                                                <MenuItem Header="跳转到所在页面" Tag="{Binding}" Click="JumpToBookmarkClick" />
                                                <MenuItem Header="重新读取 OCR 记录" Tag="{Binding}" Click="ReattachBookmarkOcrClick" />
                                                <MenuItem Header="修改书签名称" Tag="{Binding}" Click="RenameBookmarkClick" />
                                                <MenuItem Header="挂载为子书签" Tag="{Binding}" Click="AttachBookmarkAsChildClick" />
                                                <MenuItem Header="脱离父书签" Tag="{Binding}" Click="DetachBookmarkClick" />
                                                <MenuItem Header="删除书签" Tag="{Binding}" Click="DeleteBookmarkClick" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <TextBlock Text="{Binding PageNumber}" Foreground="#2B6CB0" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="bookmark-title"
                                                   Text="{Binding Title}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#37414A"
                                                   PointerReleased="BookmarkTitlePointerReleased" />
                                    </Grid>
                                </TreeDataTemplate>
                                <TreeDataTemplate DataType="model:OcrRecord" x:DataType="model:OcrRecord">
                                    <Grid Classes="ocr-row" ColumnDefinitions="Auto,*" Margin="0,2" Background="#F5F7F9">
                                        <Border Background="#E7DDF5"
                                                BorderBrush="#B99BD9"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="4,1"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding !HasAudio}">
                                            <TextBlock Text="OCR" Foreground="#61478A" FontSize="9" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="#E2F4E8"
                                                BorderBrush="#74B88A"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="4,1"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasAudio}">
                                            <TextBlock Text="VOC" Foreground="#2F855A" FontSize="9" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#61478A"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <Grid.ContextMenu>
                                            <ContextMenu DataContext="{Binding}" Opened="BookmarkContextMenuOpened">
                                                <MenuItem Header="查看正文" Tag="{Binding}" Click="ViewOcrTextClick" />
                                                <MenuItem Header="播放音频" Tag="{Binding}" IsEnabled="{Binding HasAudio}" Click="PlayOcrAudioClick" />
                                                <MenuItem Header="生成音频" Tag="{Binding}" IsEnabled="{Binding !HasAudio}" Click="GenerateOcrAudioClick" />
                                                <MenuItem Header="以指定模型生成"
                                                          Tag="{Binding}"
                                                          IsEnabled="{Binding !HasAudio}"
                                                          SubmenuOpened="GenerateOcrWithVoiceSubmenuOpened">
                                                    <MenuItem Header="加载模型列表..." IsEnabled="False" />
                                                </MenuItem>
                                                <MenuItem Header="以指定模型重新生成"
                                                          Tag="{Binding}"
                                                          IsEnabled="{Binding HasAudio}"
                                                          SubmenuOpened="RegenerateOcrWithVoiceSubmenuOpened">
                                                    <MenuItem Header="加载模型列表..." IsEnabled="False" />
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="移除此条记录" Tag="{Binding}" Click="RemoveOcrRecordClick" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                    </Grid>
                                </TreeDataTemplate>
                                    </TreeView.DataTemplates>
                                </TreeView>
                                <Canvas x:Name="BookmarkDragOverlay" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter x:Name="SidebarSplitter"
                          Grid.Column="2"
                          Background="#D9DDE2"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          PointerReleased="SidebarSplitterPointerReleased"
                          ToolTip.Tip="拖动调整左侧栏宽度" />

            <Border Grid.Column="3" Background="#E9EBEE" Padding="28,24">
                <Grid>
                    <ListBox x:Name="ContinuousReadingList"
                             IsVisible="{Binding IsContinuousReadingMode}"
                             ItemsSource="{Binding ReadingPages}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="model:ReadingPage">
                                <StackPanel Margin="0,0,0,18">
                                    <Border Width="{Binding Width}"
                                            Height="{Binding Height}"
                                            Background="White"
                                            BoxShadow="0 2 12 0 #24000000">
                                        <Grid>
                                            <Image Source="{Binding PreviewImage}" Stretch="Fill" />
                                            <Image Source="{Binding Image}"
                                                   Stretch="Fill"
                                                   AttachedToVisualTree="ReadingPageImageAttachedToVisualTree"
                                                   DetachedFromVisualTree="ReadingPageImageDetachedFromVisualTree" />
                                            <controls:OcrOverlayControl Records="{Binding OcrRecords}"
                                                                        IsVisible="{Binding IsOcrVisible}"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Stretch" />
                                            <controls:AnnotationOverlayControl Annotations="{Binding Annotations}"
                                                                              IsHitTestVisible="False"
                                                                              HorizontalAlignment="Stretch"
                                                                              VerticalAlignment="Stretch" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding PageNumber}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"
                                               Foreground="#6B7280"
                                               FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                <ScrollViewer x:Name="DocumentScrollViewer"
                              IsVisible="{Binding !IsContinuousReadingMode}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="DocumentScrollViewerScrollChanged">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" RowDefinitions="Auto,Auto,Auto">
                        <Border Grid.Row="0"
                                Background="White"
                                BoxShadow="0 2 12 0 #24000000"
                                IsVisible="{Binding HasPreviousReadingPage}">
                            <Image Source="{Binding PreviousReadingPageImage}" Stretch="None" />
                        </Border>
                        <Border Grid.Row="1" Background="White" BoxShadow="0 2 12 0 #24000000" IsVisible="{Binding HasDocument}">
                            <Grid x:Name="PageSurface"
                                  PointerPressed="PageSurfacePointerPressed"
                                  PointerMoved="PageSurfacePointerMoved"
                                  PointerReleased="PageSurfacePointerReleased">
                                <Image Source="{Binding PageImage}" Stretch="None" />
                                <Canvas x:Name="AnnotationStrokePreview" IsHitTestVisible="False" />
                                <Canvas x:Name="PdfAnnotationOverlay" />
                                <Canvas x:Name="CurrentPageOcrOverlay"
                                        IsVisible="{Binding IsCurrentPageOcrVisible}" />
                                <Canvas IsHitTestVisible="False">
                                    <Rectangle x:Name="SelectionBox"
                                               Fill="#334A90E2"
                                               Stroke="#2B6CB0"
                                               StrokeThickness="2"
                                               IsVisible="False" />
                                </Canvas>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" IsVisible="{Binding !HasDocument}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="80">
                            <TextBlock Text="打开一个 PDF 开始阅读" FontSize="22" FontWeight="SemiBold" Foreground="#46515C" HorizontalAlignment="Center" />
                            <TextBlock Text="支持页面渲染、目录、文本选择、OCR 和语音朗读" Foreground="#7B858F" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Row="2"
                                Background="White"
                                BoxShadow="0 2 12 0 #24000000"
                                IsVisible="{Binding HasNextReadingPage}">
                            <Image Source="{Binding NextReadingPageImage}" Stretch="None" />
                        </Border>
                    </Grid>
                </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#D9DDE2" BorderThickness="1,0,0,0" Padding="18,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                    <TextBlock Text="工作区" FontSize="13" FontWeight="SemiBold" Foreground="#66717C" />
                    <Border Background="#FFF8E8"
                            BorderBrush="#E6A23C"
                            BorderThickness="1"
                            Padding="14"
                            IsVisible="{Binding IsAnnotationMode}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="标注样式" FontWeight="SemiBold" Foreground="#6B4D12" />
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center" ColumnSpacing="8">
                                <TextBlock Text="宽度" Foreground="#6B4D12" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding AnnotationStrokeWidth, Mode=TwoWay}"
                                               Minimum="1"
                                               Maximum="20"
                                               Increment="1"
                                               FormatString="0"
                                               Width="140"
                                               MinWidth="140"
                                               Height="32"
                                               HorizontalContentAlignment="Center"
                                               Foreground="#303943"
                                               Background="#FFFFFF" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding AnnotationStrokeWidthText}"
                                           Foreground="#6B4D12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Height="38" Background="#FFFFFF" ClipToBounds="True">
                                <Line StartPoint="12,19"
                                      EndPoint="220,19"
                                      Stroke="{Binding AnnotationColorBrush}"
                                      StrokeThickness="{Binding AnnotationStrokeWidth}"
                                      StrokeLineCap="Round" />
                            </Grid>
                            <TextBlock Text="线宽预览" Foreground="#8A6A2A" FontSize="11" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HasSelectedFreeTextAnnotation}">
                                <TextBlock Text="字号" Foreground="#6B4D12" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding AnnotationTextFontSize, Mode=TwoWay}" Minimum="6" Maximum="72" Increment="1" FormatString="0" Width="140" Height="32" Background="#FFFFFF" />
                            </Grid>
                            <TextBlock Text="颜色" Foreground="#6B4D12" />
                            <WrapPanel Orientation="Horizontal" ItemWidth="30" ItemHeight="30">
                                <Button Tag="#1D4ED8" Click="AnnotationColorClick" Background="#1D4ED8" ToolTip.Tip="蓝色" Margin="0,0,5,5" />
                                <Button Tag="#DC2626" Click="AnnotationColorClick" Background="#DC2626" ToolTip.Tip="红色" Margin="0,0,5,5" />
                                <Button Tag="#16A34A" Click="AnnotationColorClick" Background="#16A34A" ToolTip.Tip="绿色" Margin="0,0,5,5" />
                                <Button Tag="#F59E0B" Click="AnnotationColorClick" Background="#F59E0B" ToolTip.Tip="橙色" Margin="0,0,5,5" />
                                <Button Tag="#7C3AED" Click="AnnotationColorClick" Background="#7C3AED" ToolTip.Tip="紫色" Margin="0,0,5,5" />
                                <Button Tag="#111827" Click="AnnotationColorClick" Background="#111827" ToolTip.Tip="黑色" Margin="0,0,5,5" />
                                <Button Content="自定义"
                                        Click="OpenAnnotationColorPickerClick"
                                        Background="{Binding AnnotationColorBrush}"
                                        Foreground="White"
                                        Padding="5,2"
                                        ToolTip.Tip="打开拾色器"
                                        Margin="0,0,5,5" />
                            </WrapPanel>
                            <TextBlock Text="{Binding AnnotationColorHex}" Foreground="#8A6A2A" FontSize="11" />
                            <Border IsVisible="{Binding HasSelectedPdfAnnotation}"
                                    Background="#FFF2D6"
                                    BorderBrush="#E6A23C"
                                    BorderThickness="1"
                                    Padding="8">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                    <TextBlock Text="选中标注" FontWeight="SemiBold" Foreground="#6B4D12" />
                                    <TextBlock Grid.Row="1" Text="颜色" Foreground="#8A6A2A" FontSize="11" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAnnotationColor}" Foreground="#303943" FontFamily="Consolas" />
                                    <TextBlock Grid.Row="2" Text="线宽" Foreground="#8A6A2A" FontSize="11" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAnnotationStrokeWidth}" Foreground="#303943" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Background="#F5F7F9" BorderBrush="#E1E5E9" BorderThickness="1" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="OCR 选区" FontWeight="SemiBold" Foreground="#414B55" />
                            <TextBlock Text="OCR 默认关闭，启动后选择截取模式。" TextWrapping="Wrap" Foreground="#89929C" FontSize="13" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                                <Button Grid.Row="0" Grid.Column="0" Content="启动 OCR" Command="{Binding StartOcrCommand}" IsEnabled="{Binding !IsOcrEnabled}" Padding="10,7" />
                                <Button Grid.Row="1" Grid.Column="0" Content="放弃结果" Command="{Binding CancelOcrCommand}" Click="CancelOcrClick" IsEnabled="{Binding CanCancelOcr}" Padding="10,7" />
                                <Button Grid.Row="0" Grid.Column="1" Content="截取一次" Command="{Binding CaptureOnceCommand}" IsEnabled="{Binding CanSelectCaptureMode}" Padding="10,7" />
                                <Button Grid.Row="1" Grid.Column="1" Content="持续截取" Command="{Binding ToggleContinuousCaptureCommand}" IsEnabled="{Binding CanSelectCaptureMode}" Padding="10,7" />
                                <Button Grid.Row="2" Grid.Column="0" Content="保存" Command="{Binding SaveOcrCommand}" IsEnabled="{Binding CanConfirmOcr}" Padding="10,7" />
                                <Button Grid.Row="2" Grid.Column="1" Content="取消截取" Command="{Binding CancelCaptureModeCommand}" IsEnabled="{Binding CanCancelCapture}" Padding="10,7" />
                            </Grid>
                            <TextBox Text="{Binding OcrTitle}" PlaceholderText="OCR 标题" />
                            <TextBox Text="{Binding OcrText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxHeight="280" />
                            <TextBlock Text="{Binding LastCapturePath}" TextWrapping="Wrap" Foreground="#89929C" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="OcrProcessingPanel" Background="#F5F7F9" BorderBrush="#E1E5E9" BorderThickness="1" Padding="14">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="OCR 待处理记录" FontWeight="SemiBold" Foreground="#414B55" />
                                <Button Grid.Column="1"
                                        Content="清除"
                                        Click="ClearOcrRecordClick"
                                        IsEnabled="{Binding CanClearOcr}"
                                        Padding="9,4" />
                            </Grid>
                    <ListBox x:Name="OcrHistoryList"
                             ItemsSource="{Binding OcrProcessingQueue}"
                             SelectedItem="{Binding SelectedOcrHistoryRecord, Mode=TwoWay}"
                             Height="180"
                             DoubleTapped="OcrHistoryDoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="model:OcrRecord">
                                        <StackPanel Spacing="2" Margin="0,3">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="#61478A" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding QueueStatusText}" Foreground="{Binding QueueStatusBrush}" FontSize="10" />
                                        </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="挂载"
                                Command="{Binding AttachOcrToBookmarkCommand}"
                                IsEnabled="{Binding CanAttachOcr}"
                                Background="#D99A21"
                                Foreground="White"
                                Padding="12,7" />
                        <Button Content="生成音频"
                                Command="{Binding GenerateSpeechCommand}"
                                IsEnabled="{Binding CanGenerateSpeech}"
                                Padding="12,7" />
                        <Button Content="仅保存"
                                Command="{Binding SaveOcrOnlyCommand}"
                                IsEnabled="{Binding CanSaveOcrOnly}"
                                Padding="12,7" />
                    </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
