<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PDFReader.MissingDocumentWindow"
        Title="PDF 文件不可用"
        Width="560"
        Height="300"
        MinWidth="500"
        MinHeight="260"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto" Background="#F5F6F8">
        <StackPanel Grid.Row="0" Spacing="12" Margin="24">
            <TextBlock Text="找不到 PDF 文件" FontSize="20" FontWeight="SemiBold" Foreground="#303943" />
            <TextBlock x:Name="DocumentTitleText" Foreground="#4A5560" TextWrapping="Wrap" />
            <TextBlock x:Name="DocumentPathText" Foreground="#737E88" TextWrapping="Wrap" />
            <TextBlock Text="请选择如何处理这个 PDF 文档对象。删除操作会同时删除其书签、OCR 记录、音频和截图资源。"
                       Foreground="#737E88"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D9DDE2" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="暂时搁置" Click="PostponeClick" Padding="14,8" />
                <Button Content="重新绑定" Click="RebindClick" Padding="14,8" Background="#2B6CB0" Foreground="White" />
                <Button Content="删除 PDF 及资源" Click="DeleteClick" Padding="14,8" Background="#C53030" Foreground="White" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
