<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PDFReader.AnnotationCreateWindow"
        Title="添加 PDF 标注"
        Width="520"
        Height="360"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="#F5F6F8" Margin="20">
        <TextBlock Text="标注标题" FontSize="16" FontWeight="SemiBold" Foreground="#303943" />
        <TextBox x:Name="TitleInput"
                 Grid.Row="1"
                 Margin="0,10,0,14"
                 PlaceholderText="例如：重点、疑问、补充" />
        <TextBox x:Name="ContentsInput"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 PlaceholderText="请输入标注正文" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="取消" Click="CancelClick" Padding="14,7" />
            <Button Content="保存标注" Click="ConfirmClick" Padding="14,7" Background="#2B6CB0" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
