<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="using:PDFReader.Models"
        x:Class="PDFReader.PdfDocumentPickerWindow"
        x:CompileBindings="False"
        Title="选择 PDF 文件"
        Width="760"
        Height="560"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Background="#F5F6F8" Margin="20">
        <StackPanel Spacing="4">
            <TextBlock Text="PDF 文件记录" FontSize="16" FontWeight="SemiBold" Foreground="#303943" />
            <TextBlock Text="选择已有记录，或添加新的 PDF 文件；确认后导入到当前工作区。"
                       Foreground="#737E88"
                       FontSize="12" />
        </StackPanel>

        <ListBox x:Name="DocumentList"
                 Grid.Row="1"
                 ItemsSource="{Binding}"
                 SelectionMode="Multiple"
                 Margin="0,16,0,16">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="model:PdfDocument">
                    <StackPanel Spacing="2" Margin="4,5">
                        <TextBlock Text="{Binding FilePath}"
                                   TextWrapping="Wrap"
                                   Foreground="#37414A"
                                   FontSize="12" />
                        <TextBlock Text="{Binding PathStatus}"
                                   IsVisible="{Binding IsMissing}"
                                   Foreground="#C2410C"
                                   FontSize="11" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#D9DDE2"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Content="新 PDF"
                        Click="AddNewPdfClick"
                        Padding="14,8"
                        Background="#2B6CB0"
                        Foreground="White" />
                <TextBlock Grid.Column="1"
                           Text="可多选 PDF 文件记录"
                           VerticalAlignment="Center"
                           Foreground="#737E88"
                           FontSize="12" />
                <Button Grid.Column="2"
                        Content="取消"
                        Click="CancelClick"
                        Padding="16,8" />
                <Button Grid.Column="3"
                        Content="导入到工作区"
                        Click="ImportClick"
                        Padding="16,8"
                        Background="#2B6CB0"
                        Foreground="White" />
            </Grid>
        </Border>
    </Grid>
</Window>
