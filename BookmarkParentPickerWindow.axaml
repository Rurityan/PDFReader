<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="clr-namespace:PDFReader.Models"
        x:Class="PDFReader.BookmarkParentPickerWindow"
        Title="挂载为子书签"
        Width="480"
        Height="430"
        MinWidth="400"
        MinHeight="330"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Background="#F5F6F8" Margin="20">
        <TextBlock Text="选择父书签" FontSize="16" FontWeight="SemiBold" Foreground="#303943" />
        <TextBox x:Name="SearchInput"
                 Grid.Row="1"
                 PlaceholderText="输入书签名称筛选"
                 TextChanged="SearchInputTextChanged" />
        <ListBox x:Name="BookmarkList" Grid.Row="2" ItemsSource="{Binding $parent[Window].DataContext}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="model:Bookmark">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="4,3">
                        <TextBlock Text="{Binding PageNumber}" Foreground="#2B6CB0" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" Foreground="#37414A" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="取消" Click="CancelClick" Padding="14,7" />
            <Button Content="确认挂载" Click="ConfirmClick" Padding="14,7" Background="#D99A21" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
