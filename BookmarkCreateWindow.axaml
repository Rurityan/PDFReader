<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PDFReader.BookmarkCreateWindow"
        Title="创建书签"
        Width="440"
        Height="250"
        MinWidth="380"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        KeyDown="WindowKeyDown">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="#F5F6F8" Margin="20">
        <TextBlock Text="书签标题" FontSize="16" FontWeight="SemiBold" Foreground="#303943" />
        <TextBox x:Name="TitleInput"
                 Grid.Row="1"
                 Margin="0,10,0,14"
                 PlaceholderText="请输入书签标题" />
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="页码" FontSize="13" Foreground="#66717C" />
            <NumericUpDown x:Name="PageInput"
                           Minimum="1"
                           FormatString="0"
                           HorizontalAlignment="Left"
                           Width="140" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="取消" Click="CancelClick" Padding="14,7" />
            <Button Content="创建" Click="ConfirmClick" Padding="14,7" Background="#2B6CB0" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
